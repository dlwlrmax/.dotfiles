# Copy to `.env` and fill in — the real `.env` is gitignored, this template is not.
#
#   cp .env.example .env && chmod 600 .env
#
# Values come from the Lark Developer Console for the app `LangTech MCP`
# (cli_aa787b9aae389f04). The same pair also lives in
# ~/.config/opencode/secrets.env for the OpenCode `lark` MCP server.
#
# Tenant: wsg302up0spw  →  international domain https://open.larksuite.com
#
# Rotate the secret in the console if it has ever been pasted into a chat,
# then update both this file's `.env` copy and ~/.config/opencode/secrets.env.
LARK_APP_ID=
LARK_APP_SECRET=

# Base "QUẢN LÝ CÔNG VIỆC" (scripts/lark-task.sh) — ids, not secrets.
LARK_BASE_APP_TOKEN=VSQEbM6kBaFCRbseuH6lHqFRg7f
LARK_TASKS_TABLE=tblMADnsPIRSSjLw
LARK_ORDERS_TABLE=tblrCCmpKOtoC9Vc
# open_id of the person new tasks / orders are assigned to.
LARK_ASSIGNEE_OPEN_ID=
# Used only to build the "open in Lark" link of a created task.
LARK_BASE_URL=https://wsg302up0spw.sg.larksuite.com/base
# provider/model for the OpenCode review (scripts/lark-review.sh); empty = OpenCode default.
LARK_REVIEW_MODEL=

.opencode
.env*
!.env.example
**/target/
AGENTS.md
node_modules/
package.json
pnpm-lock.yaml
~/
*.pem
.tmp
__pycache__/
# fish: ignore vendored plugin files, track hand-written config
fish/.config/fish/completions/*
!fish/.config/fish/completions/lerd.fish
fish/.config/fish/conf.d/*
# lerd.fish is generated by `lerd install`/`lerd update` - not tracked
!fish/.config/fish/conf.d/zz-path-dedupe.fish
!fish/.config/fish/conf.d/oh-my-opencode-slim.fish
!fish/.config/fish/conf.d/fish_frozen_theme.fish
fish/.config/fish/functions/*
!fish/.config/fish/functions/y.fish
!fish/.config/fish/functions/fish_user_key_bindings.fish
!fish/.config/fish/functions/fish_greeting.fish
fish/.config/fish/functions/tide/
fish/.config/fish/themes/
fish/.config/fish/secrets.local.fish
fish_variables*
*.bak
*.bak.*
.omo
mimeinfo
opencode/.config/opencode/service.json
opencode/.config/opencode/.oh-my-opencode-slim/skills-manifest.json
opencode/.config/opencode/skills/*
!opencode/.config/opencode/skills/estudy-backend/
!opencode/.config/opencode/skills/estudy-backend/*
!opencode/.config/opencode/skills/sql-langmaster/
!opencode/.config/opencode/skills/sql-langmaster/**
!opencode/.config/opencode/skills/figma-mcp/

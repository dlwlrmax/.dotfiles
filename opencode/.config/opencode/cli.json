{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-macchiato"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "new_location": "inherit"
  },
  "tabs": {
    "scope": "global"
  },
  "animations": true,
  "keybinds": {
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab",
    "session.tab.select.1": "alt+1,<leader>1",
    "session.tab.select.2": "alt+2,<leader>2",
    "session.tab.select.3": "alt+3,<leader>3",
    "session.tab.select.4": "alt+4,<leader>4"
  }
}

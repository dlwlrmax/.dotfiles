{
  "plugin": [
    "oh-my-opencode-slim"
  ],
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  // "default_agent": "OpenCoder",
  // "agents": {
  //   "OpenCoder": {
  //     "model": "openrouter/xiaomi/mimo-v2.5"
  //   }
  // },
  "permission": {
    "external_directory": {
      "~/.config/opencode/context/**": "allow"
    }
  },
  "compaction": {
    "prune": true
  },
  "mcp": {
    // MySQL template. Disabled globally per MCP scoping rule.
    // Enable per project by repeating type+command (v2 rejects enabled-only
    // entries as "legacy") and pinning only the database name:
    //   {"mcp":{"mysql":{"type":"local",
    //     "command":["npx","-y","@easy-mcps/mysql-mcp-server"],
    //     "environment":{"MYSQL_DATABASE":"<db>"}}}}
    // Host/port/user/password are inherited from here.
    "mysql": {
      "type": "local",
      "command": ["npx", "-y", "@easy-mcps/mysql-mcp-server"],
      "enabled": false,
      "environment": {
        "MYSQL_HOST": "{env:MYSQL_HOST}",
        "MYSQL_PORT": "{env:MYSQL_PORT}",
        "MYSQL_USER": "{env:MYSQL_USER}",
        "MYSQL_PASSWORD": "{env:MYSQL_PASSWORD}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless"],
      "enabled": false
    },
    "figma": {
      "type": "local",
      "command": ["npx", "-y", "figma-developer-mcp", "--stdio"],
      "environment": {
        "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
      },
      "enabled": false,
      "timeout": 15000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      }
    }
  },
  "provider": {
    "opencode": {
      "options": {
        "headers": {}
      }
    },
    "opencode-go": {
      "options": {
        "headers": {}
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}

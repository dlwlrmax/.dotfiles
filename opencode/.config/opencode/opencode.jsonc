{
  "plugin": [
    "opencode-agent-skills",
    "opencode-pty",
    "opencode-supermemory",
    "oh-my-opencode-slim"
  ],
  "$schema": "https://opencode.ai/config.json",
  // "default_agent": "OpenCoder",
  // "agents": {
  //   "OpenCoder": {
  //     "model": "openrouter/xiaomi/mimo-v2.5"
  //   }
  // },
  "permission": {
    "external_directory": {
      "~/.config/opencode/context/**": "allow"
    }
  },
  "compaction": {
    "prune": false
  },
  "mcp": {
    "laravel-boost": {
      "type": "local",
      "command": ["lerd", "php", "artisan", "boost:mcp"]
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless"]
    },
    "mysql": {
      "type": "local",
      "command": ["npx", "-y", "@easy-mcps/mysql-mcp-server"],
      "environment": {
        "MYSQL_HOST": "{env:MYSQL_HOST}",
        "MYSQL_PORT": "{env:MYSQL_PORT}",
        "MYSQL_USER": "{env:MYSQL_USER}",
        "MYSQL_PASSWORD": "{env:MYSQL_PASSWORD}",
        "MYSQL_DATABASE": "erp_langmaster"
      }
    }
  },
  "provider": {
    "opencode": {
      "options": {
        "headers": {
          "sleev-provider": "opencode",
          "sleev-harness": "opencode"
        },
        "baseURL": "http://127.0.0.1:17321"
      }
    },
    "opencode-go": {
      "options": {
        "headers": {
          "sleev-provider": "opencode-go",
          "sleev-harness": "opencode"
        },
        "baseURL": "http://127.0.0.1:17321"
      }
    },
    "openrouter": {
      "options": {
        "headers": {
          "sleev-provider": "openrouter",
          "sleev-harness": "opencode"
        },
        "baseURL": "http://127.0.0.1:17321"
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}
